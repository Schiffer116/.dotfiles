{
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/schiffer/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "gh-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "chrome-devtools-axi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear)$",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/berthier session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/berthier hook-stop",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\""
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  },
  "viewMode": "focus",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "theme": "dark",
  "preferredNotifChannel": "notifications_disabled",
  "autoMode": {
    "soft_deny": [
      "$defaults"
    ],
    "environment": [
      "**Host containment**: None configured - assume Claude Code runs on an ordinary developer machine with open internet",
      "**Primary use of Claude Code**: software development",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Project facts**: repo-specific trust (accounts, buckets, branches, IaC scopes) lives in each repo's .claude/settings.local.json, not here"
    ]
  },
  "voiceEnabled": true,
  "permissions": {
    "deny": [
      "SendFeedback",
      "ScheduleWakeup",
      "ReportFindings",
      "ListAgents"
    ]
  },
  "skillOverrides": {
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:setup-writing-style": "off"
  },
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  }
}
