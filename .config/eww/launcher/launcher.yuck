(defvar show_launcher true)
(defwindow launcher
  :stacking "overlay"
  :focusable "exclusive"
  :exclusive true

  :monitor '[1, 0]'
  :geometry (geometry :width "100%"
                      :anchor "bottom center")
  (box
    (revealer :reveal show_launcher
              :transition "slideup"
              :duration "300ms"
      (box :space-evenly false
        (input_box)
        (candidate_list)
        (page_footer)))))

(defvar app_all_json "[]")
(defvar app_json "[]")
(defvar app_page 0)
(defvar app_total_pages 1)
(defvar selected_app_index 0)

(defwidget input_box []
  (box :class "search-box"
         :space-evenly false
      (label :class "search-icon"
             :text "")
      (input :class "search-input"
             :onchange "launcher.sh search \"{}\""
             :timeout "2000ms"
             :onaccept "launcher.sh launch"
             :hexpand true)))

(defwidget candidate_list []
  (box :space-evenly false
       :hexpand true
    (for entry in app_json
      (eventbox :class "app-item-event"
                :cursor "pointer"
                :onclick "launcher.sh launch '${entry}' &"
        (label :class "app-item ${app_json?.[selected_app_index] == entry ? 'app-item-active' : ''}"
               :xalign 0.5
               :text entry)))))

(defwidget page_footer []
  (box :class "page-footer"
       :space-evenly false
       :halign "center"
       :visible {app_total_pages > 1}
    (eventbox :cursor "pointer"
              :onclick "launcher.sh previous-page"
      (label :class "page-arrow" :text "‹"))
    (label :class "page-label"
           :text "${app_page + 1} / ${app_total_pages}")
    (eventbox :cursor "pointer"
              :onclick "launcher.sh next-page"
      (label :class "page-arrow" :text "›"))))
