(include "./bar/widgets.yuck")

(defwindow bar [workspace_base monitor_name]
  :stacking "fg"
  :exclusive true

  :monitor monitor_name
  :geometry (geometry
    :width "100%"
    :height 40
    :anchor "top center")
  (bar :workspace_base workspace_base :monitor_name monitor_name))

(defwidget bar [workspace_base monitor_name]
  (centerbox :orientation "h"
    (left :workspace_base workspace_base :monitor_name monitor_name)
    (center)
    (right :workspace_base workspace_base :monitor_name monitor_name)))

(defwidget sep []
  (label :class "sep" :text "|"))

(defwidget right_triangle [fg bg]
  (box :class "right-triangle"
       :style "background: ${bg}; border-left: 25px solid ${fg};"))

(defwidget left [workspace_base monitor_name]
  (box :orientation "h"
       :space-evenly false
       :halign "start"
    (power)
    (right_triangle :fg theme-sapphire
                    :bg theme-mantle)
    (workspaces :workspace_base workspace_base :monitor_name monitor_name)
    (right_triangle :fg theme-mantle
                    :bg theme-bg)
    (monitor :css_class "cpu" :kind "cpu" :tip hw_tip_cpu :value {EWW_CPU.avg})
    (monitor :css_class "ram" :kind "ram" :tip hw_tip_ram :value {EWW_RAM.used_mem_perc})
    (monitor :css_class "rom" :kind "disk" :tip hw_tip_disk :value {EWW_DISK["/"].used_perc})
    (claude_usage)
    (sep)
    (claude_agents)))

(defwidget center []
  (box :orientation "h" :space-evenly false :halign "center"
    (media_player)))

(defwidget right [workspace_base monitor_name]
  (box :orientation "h" :space-evenly false :halign "end"
    (language)
    (sep)
    (temp)
    (backlight :brightness {levels.brightness} :monitor_name monitor_name)
    (sound :volume {levels.volume} :muted {levels.muted})
    (network)
    (battery)
    (right_triangle :fg theme-bg
                    :bg theme-surface)
    (clock :monitor_name monitor_name)))
