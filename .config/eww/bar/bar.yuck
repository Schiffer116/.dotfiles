(include "./bar/widgets.yuck")
(include "./color.yuck")

(defwindow bar [monitor_id]
  :stacking "fg"
  :exclusive true

  :monitor monitor_id
  :geometry (geometry
    :width "100%"
    :height 40
    :anchor "top center")
  (bar :monitor_id monitor_id))

(defwidget bar [monitor_id]
  (centerbox :orientation "h"
    (left :monitor_id monitor_id)
    (center)
    (right :monitor_id monitor_id)))

(defwidget sep []
  (label :class "sep" :text "|"))

(defwidget left_triangle [fg bg]
  (box :class "left-triangle"
       :style "background: ${bg}; border-right: 25px solid ${fg};"))

(defwidget right_triangle [fg bg]
  (box :class "right-triangle"
       :style "background: ${bg}; border-left: 25px solid ${fg};"))

(defwidget left [monitor_id]
  (box :orientation "h"
       :space-evenly false
       :halign "start"
    (power)
    (right_triangle :fg nix-blue
                    :bg bd-color)
    (workspaces :monitor_id monitor_id)
    (right_triangle :fg bd-color
                    :bg bg-color)
    (monitor :css_class "cpu" :value {EWW_CPU.avg})
    (monitor :css_class "ram" :value {EWW_RAM.used_mem_perc})
    (monitor :css_class "rom" :value {EWW_DISK["/"].used_perc})
    (sep)
    (current_window)))

(defwidget center []
  (box :orientation "h" :space-evenly false :halign "center"
    (media_player)))

(defwidget right [monitor_id]
  (box :orientation "h" :space-evenly false :halign "end"
    (language)
    (sep)
    (temp)
    (backlight :brightness brightness)
    (sound :volume volume)
    (network)
    (battery)
    (right_triangle :fg bg-color
                    :bg bg-grad-1)
    (clock :monitor_id monitor_id)))
