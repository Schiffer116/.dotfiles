(include "./bar/infos.yuck")

(defwidget power []
  (eventbox :class "power-event-box"
            :cursor "pointer"
            :onclick "powermenu.sh open"
            :onrightclick "eww reload"
    (label :class "os-logo"
           :text "󰣇")))

(defvar monitors '[
  {
    "id": 0,
    "name": "eDP-1",
    "currentWorkspace": 1,
    "previousWorkspace": 1
  },
  {
    "id": 1,
    "name": "HDMI-A-1",
    "currentWorkspace": 11,
    "previousWorkspace": 11
  }
]')

(defwidget workspace [id monitor_id icon]
    (eventbox :class "workspace"
              :cursor "pointer"
              :onclick `hyprctl dispatch 'hl.dsp.focus({ workspace = "${id}" })'`
    (box :space-evenly false
      (label :text icon
             :class "workspace-label
                     workspace-label${id == jq(monitors, '.[] | select(.id == ${monitor_id}) | .currentWorkspace') ? '-active ' : ' '}
                     workspace-label${id == jq(monitors, '.[] | select(.id == ${monitor_id}) | .previousWorkspace') ? '-previous ' : ' '}"))))


(defwidget workspaces [monitor_id]
  (box :class "workspaces"
       :spacing 5
    (workspace :id {monitor_id * 10 + 1} :monitor_id monitor_id :icon "󰈹")
    (workspace :id {monitor_id * 10 + 2} :monitor_id monitor_id :icon "")
    (workspace :id {monitor_id * 10 + 3} :monitor_id monitor_id :icon "")
    (workspace :id {monitor_id * 10 + 4} :monitor_id monitor_id :icon "")
    (workspace :id {monitor_id * 10 + 5} :monitor_id monitor_id :icon "")))


(defvar cur_win "")
(defwidget current_window []
    (label :text cur_win
           :truncate true
           :limit-width 35
           :style "margin-left: 10px; color: white;"))


(defwidget monitor [value css_class]
  (eventbox :onclick `hyprctl dispatch "hl.dsp.exec_cmd('kitty -e btop', { float = true, size = { 'monitor_w * 0.7', 'monitor_h * 0.7' } })"`
            :cursor "pointer"
    (circular-progress :class "circle ${css_class}"
                       :value value
                       :start-at 75
                       :thickness 4
        (label :class "circ-icon"
               :text "" ))))


(defvar full_time false)
(defwidget clock []
  (eventbox :onclick "${EWW_CMD} open --toggle calendar"
            :onhover "${EWW_CMD} update full_time=true"
            :onhoverlost "${EWW_CMD} update full_time=false"
            :cursor "pointer"
    (box :class "clock"
         :space-evenly false
      (revealer :transition "slideleft"
                :reveal full_time
                :duration "300ms"
        (label :text {formattime(EWW_TIME, "%a, %b %d, ")}))
      (label :text {formattime(EWW_TIME, "%H:%M")})
      (revealer :transition "slideright"
                :reveal full_time
                :duration "300ms"
        (label :text {formattime(EWW_TIME, ":%S")})))))

(deflisten has_battery
  :initial "false"
  "[ -d /sys/class/power_supply/BAT0 ] && echo true || echo false")

(defwidget battery [?role]
  (box :space-evenly false
       :class "pill-wrapper"
       :visible has_battery
    (label :class "battery ${role}"
           :text { EWW_BATTERY.BAT0.status == "Charging" ? "󱐌" :
                   EWW_BATTERY.BAT0.capacity <= 20 ? "" :
                   EWW_BATTERY.BAT0.capacity <= 40 ? "" :
                   EWW_BATTERY.BAT0.capacity <= 60 ? "":
                   EWW_BATTERY.BAT0.capacity <= 80 ? "" : "" })
    (label :class "battery"
           :style "font-size: 15px; margin-left: 0"
           :text "${EWW_BATTERY.BAT0.capacity}%")))


(deflisten volume "volume.sh get")
(deflisten muted "volume.sh is-muted")
(defwidget sound [volume]
  (eventbox :onscroll "[ {} = 'up' ] && volume.sh increase || volume.sh decrease"
            :onclick `hyprctl dispatch "hl.dsp.exec_cmd('pavucontrol', { float = true, size = { 'monitor_w * 0.5', 'monitor_h * 0.5' } })"`
            :onmiddleclick "volume.sh toggle-mute &"
            :onrightclick `hyprctl dispatch "hl.dsp.exec_cmd('blueman-manager', { float = true, size = { 'monitor_w * 0.5', 'monitor_h * 0.5' } })"`
            :cursor "pointer"
    (box :space-evenly false
         :class "pill-wrapper"
      (label :class "sound"
             :text { muted ? "󰝟" :
                     volume < 34 ? "" :
                     volume < 67 ? "" : "" })
      (label :class "sound"
             :style "font-size: 15px; margin-left: 0"
             :text "${volume}%"))))


(deflisten network_name "nmcli --terse --fields 'NAME' connection show --active | head -1;
                         nmcli connection monitor | awk -F ':' '{ print $1; fflush() }'")
(deflisten network_type "nmcli --terse --fields 'TYPE' connection show --active | head -1;
                        nmcli connection monitor | awk -F ':' '{ print $1; fflush() }'")
(defpoll network_strength :interval "5s"
                          :initial "N/A"
                          `nmcli -t -f SIGNAL,ACTIVE device wifi | awk -F':' '{ if ($2 == "yes") print $1 }'`)
(defwidget network [?role]
  (eventbox :onclick `hyprctl dispatch "hl.dsp.exec_cmd('kitty -e nmtui', { float = true, size = { 'monitor_w * 0.6', 'monitor_h * 0.6' } })"`
            :cursor "pointer"
    (box :space-evenly false
         :class "pill-wrapper"
    (label :class "network ${role}"
           :text { matches(network_type, "ethernet") ? "󱎔" :
                   network_strength == "" ? "󰤮" :
                   network_strength < 26 ? "󰤟" :
                   network_strength < 51 ? "󰤢" :
                   network_strength < 76 ? "󰤥" : "󰤨" })
    (label :class "network"
           :style "font-size: 15px; margin-left: 0"
           :text network_name))))

(defvar color_temp 1000)
(defwidget temp []
  (eventbox :onscroll "[ {} = 'up' ] && color-temp.sh increase || color-temp.sh decrease"
    (box :space-evenly false
         :class "pill-wrapper"
      (label :class "color-temp"
             :text { color_temp < 1375 ? "" :
                     color_temp < 1750 ? "" :
                     color_temp < 2125 ? "" :
                     color_temp < 2500 ? "" : "" })
      (label :class "color-temp"
             :style "font-size: 15px; margin-left: 0"
             :text "${color_temp}K"))))


(deflisten brightness "brightness.sh get")
;; (deflisten nightlight "brightness.sh is-nightlight")
(defwidget backlight [brightness]
  (eventbox :onscroll "[ {} = 'up' ] && brightness.sh increase || brightness.sh decrease"
    (box :space-evenly false
         :class "pill-wrapper"
         :style "
           color: rgba(238, 212, 159, 1);
           text-shadow: 0 0 2px rgba(238, 212, 159, 1);
         "
      (label :class "backlight"
             :text { brightness < 26 ? "󰃞" :
                     brightness < 51 ? "󰃝" :
                     brightness < 76 ? "󰃟" : "󰃠"})
      (label :class "backlight"
             :style "font-size: 15px; margin-left: 0"
             :text "${brightness}%"))))


(defvar show_all_lang false)
(defvar all_lang '["E","J","V"]')
(defvar cur_lang "E")
(defwidget language []
  (eventbox :cursor "pointer"
            :onhover "${EWW_CMD} update show_all_lang=true"
            :onhoverlost "${EWW_CMD} update show_all_lang=false"
    (box :space-evenly false
      (for language in all_lang
        (revealer :transition "slideleft"
                  :reveal {cur_lang == language || show_all_lang}
                  :duration "300ms"
            (button :class "lang-button"
                    :onclick "language.sh set ${language}; ${EWW_CMD} update show_all_lang=false"
              (label :class "language"
                     :text {language})))))))
