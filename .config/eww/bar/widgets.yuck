(include "./bar/infos.yuck")

(defwidget power []
  (eventbox :class "power-event-box"
            :cursor "pointer"
            :onclick "powermenu.sh open"
            :onrightclick "eww reload"
    (label :class "os-logo"
           :text "󰣇")))

(deflisten hypr_state
  :initial '{"monitors": [], "cur_win": ""}'
  "hypr_ipc.sh")

(defwidget workspace [id monitor_name icon]
    (eventbox :class "workspace"
              :cursor "pointer"
              :onclick `hyprctl dispatch 'hl.dsp.focus({ workspace = "${id}" })'`
    (box :space-evenly false
      (label :text icon
             :class "workspace-label
                     workspace-label${id == jq(hypr_state, '.monitors[] | select(.name == "${monitor_name}") | .currentWorkspace') ? '-active ' : ' '}
                     workspace-label${id == jq(hypr_state, '.monitors[] | select(.name == "${monitor_name}") | .previousWorkspace') ? '-previous ' : ' '}"))))


(defwidget workspaces [workspace_base monitor_name]
  (box :class "workspaces"
       :spacing 5
    (workspace :id {workspace_base + 1} :monitor_name monitor_name :icon "󰈹")
    (workspace :id {workspace_base + 2} :monitor_name monitor_name :icon "")
    (workspace :id {workspace_base + 3} :monitor_name monitor_name :icon "")
    (workspace :id {workspace_base + 4} :monitor_name monitor_name :icon "")
    (workspace :id {workspace_base + 5} :monitor_name monitor_name :icon "")))


(defwidget current_window []
    (label :text {hypr_state.cur_win}
           :truncate true
           :limit-width 35
           :style "margin-left: 10px; color: white;"))


(defwidget monitor [value css_class]
  (eventbox :onclick `hyprctl dispatch "hl.dsp.exec_cmd('kitty -e btop', { float = true, size = { 'monitor_w * 0.7', 'monitor_h * 0.7' } })"`
            :cursor "pointer"
    (circular-progress :class "circle ${css_class}"
                       :value value
                       :start-at 75
                       :thickness 4
        (label :class "circ-icon"
               :text "" ))))


(defvar full_time false)
(defwidget clock [monitor_name]
  (eventbox :onclick "${EWW_CMD} --no-daemonize open --screen ${monitor_name} --toggle calendar"
            :onhover "${EWW_CMD} update full_time=true"
            :onhoverlost "${EWW_CMD} update full_time=false"
            :cursor "pointer"
    (box :class "clock"
         :space-evenly false
      (revealer :transition "slideleft"
                :reveal full_time
                :duration "300ms"
        (label :text {formattime(EWW_TIME, "%a, %b %d, ")}))
      (label :text {formattime(EWW_TIME, "%H:%M")})
      (revealer :transition "slideright"
                :reveal full_time
                :duration "300ms"
        (label :text {formattime(EWW_TIME, ":%S")})))))

(deflisten has_battery
  :initial "false"
  "[ -d /sys/class/power_supply/BAT0 ] && echo true || echo false")

(defwidget battery [?role]
  (box :space-evenly false
       :class "pill-wrapper"
       :visible has_battery
    (label :class "battery ${role}"
           :text { !has_battery ? "" :
                   EWW_BATTERY.BAT0.status == "Charging" ? "󱐌" :
                   EWW_BATTERY.BAT0.capacity <= 20 ? "" :
                   EWW_BATTERY.BAT0.capacity <= 40 ? "" :
                   EWW_BATTERY.BAT0.capacity <= 60 ? "":
                   EWW_BATTERY.BAT0.capacity <= 80 ? "" : "" })
    (label :class "battery"
           :style "font-size: 15px; margin-left: 0"
           :text {has_battery ? "${EWW_BATTERY.BAT0.capacity}%" : ""})))


(deflisten levels :initial '{"volume":null,"muted":false,"brightness":{}}' "levelctl watch")
(defwidget sound [volume muted]
  (eventbox :onscroll "[ {} = 'up' ] && levelctl volume +1 || levelctl volume -1"
            :onclick `hyprctl dispatch "hl.dsp.exec_cmd('pavucontrol', { float = true, size = { 'monitor_w * 0.5', 'monitor_h * 0.5' } })"`
            :onmiddleclick "levelctl volume toggle-mute &"
            :onrightclick `hyprctl dispatch "hl.dsp.exec_cmd('blueman-manager', { float = true, size = { 'monitor_w * 0.5', 'monitor_h * 0.5' } })"`
            :cursor "pointer"
    (box :space-evenly false
         :class "pill-wrapper"
      (label :class "sound"
             :text { muted ? "󰝟" :
                     (volume ?: 0) < 34 ? "" :
                     (volume ?: 0) < 67 ? "" : "" })
      (label :class "sound"
             :style "font-size: 15px; margin-left: 0"
             :text "${volume ?: "--"}%"))))


(deflisten network_name "exec 9>/tmp/eww-network-name.lock; flock -n 9 || exit 0;
                         nmcli --terse --fields 'NAME' connection show --active | head -1;
                         nmcli connection monitor | while read -r _; do
                           nmcli --terse --fields 'NAME' connection show --active | head -1
                         done")
(deflisten network_type "exec 9>/tmp/eww-network-type.lock; flock -n 9 || exit 0;
                        nmcli --terse --fields 'TYPE' connection show --active | head -1;
                        nmcli connection monitor | while read -r _; do
                          nmcli --terse --fields 'TYPE' connection show --active | head -1
                        done")
(defpoll network_strength :interval "5s"
                          :initial ""
                          `nmcli -t -f SIGNAL,ACTIVE device wifi | awk -F':' '{ if ($2 == "yes") print $1 }'`)
(defwidget network [?role]
  (eventbox :onclick `hyprctl dispatch "hl.dsp.exec_cmd('kitty -e nmtui', { float = true, size = { 'monitor_w * 0.6', 'monitor_h * 0.6' } })"`
            :cursor "pointer"
    (box :space-evenly false
         :class "pill-wrapper"
    (label :class "network ${role}"
           :text { matches(network_type, "ethernet") ? "󱎔" :
                   network_strength == "" ? "󰤮" :
                   network_strength < 26 ? "󰤟" :
                   network_strength < 51 ? "󰤢" :
                   network_strength < 76 ? "󰤥" : "󰤨" })
    (label :class "network"
           :style "font-size: 15px; margin-left: 0"
           :text network_name))))

;; Read once whenever eww starts; color-temp.sh pushes each change (hyprsunset has no events).
(deflisten color_temp :initial 1000 "color-temp.sh get")
(defwidget temp []
  (eventbox :onscroll "[ {} = 'up' ] && color-temp.sh increase || color-temp.sh decrease"
    (box :space-evenly false
         :class "pill-wrapper"
      (label :class "color-temp"
             :text { color_temp < 1375 ? "" :
                     color_temp < 1750 ? "" :
                     color_temp < 2125 ? "" :
                     color_temp < 2500 ? "" : "" })
      (label :class "color-temp"
             :style "font-size: 15px; margin-left: 0"
             :text "${color_temp}K"))))


;; Hidden on an output without brightness control (no backlight in the monitor table).
(defwidget backlight [brightness monitor_name]
  (eventbox :onscroll "[ {} = 'up' ] && levelctl brightness +1 || levelctl brightness -1"
            :visible {(brightness[monitor_name] ?: "") != ""}
    (box :space-evenly false
         :class "pill-wrapper"
         :style "
           color: rgba(238, 212, 159, 1);
           text-shadow: 0 0 2px rgba(238, 212, 159, 1);
         "
      (label :class "backlight"
             :text { (brightness[monitor_name] ?: 0) < 26 ? "󰃞" :
                     (brightness[monitor_name] ?: 0) < 51 ? "󰃝" :
                     (brightness[monitor_name] ?: 0) < 76 ? "󰃟" : "󰃠"})
      (label :class "backlight"
             :style "font-size: 15px; margin-left: 0"
             :text "${brightness[monitor_name] ?: "--"}%"))))


(defvar show_all_lang false)
(defvar all_lang '["E","J","V"]')
;; Read once whenever eww starts; language.sh pushes each switch (fcitx5 broadcasts none).
(deflisten cur_lang :initial "E" "language.sh get")
(defwidget language []
  (eventbox :cursor "pointer"
            :onhover "${EWW_CMD} update show_all_lang=true"
            :onhoverlost "${EWW_CMD} update show_all_lang=false"
    (box :space-evenly false
      (for language in all_lang
        (revealer :transition "slideleft"
                  :reveal {cur_lang == language || show_all_lang}
                  :duration "300ms"
            (button :class "lang-button"
                    :onclick "language.sh set ${language}; ${EWW_CMD} update show_all_lang=false"
              (label :class "language"
                     :text {language})))))))
