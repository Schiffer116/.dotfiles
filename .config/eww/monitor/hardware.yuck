(defwindow monitor []
  :stacking "bg"

  :geometry (geometry
    :anchor "top left")
  (box :orientation "v"
       :spacing 20
    (cpu_monitor)
    (ram_monitor)
    (rom_monitor)
  )
)


(defwidget left_widget [icon css_class]
  (box :space-evenly false
       :spacing 20
    (label :class "circ-icon info-hardware ${css_class}"
           :text {icon}
           :halign "center"
           :width 100
           )
    (children)))

(defwidget cpu_monitor []
  (left_widget :icon ""
               :css_class "cpu"
    (box :orientation "vertical"
         :space-evenly false
         :valign "center"
         :style "color: white;"
      (label :class "info-title"
             :text "CPU"
             :xalign 0)
      (label :text "Usage: ${round(EWW_CPU.avg, 0)}%"
             :xalign 0)
      (label :text "Temp: ${EWW_TEMPS.DELL_SMM_CPU}C  "
             :xalign 0))))

(defwidget ram_monitor []
  (left_widget :icon "󰍛"
               :css_class "ram"
    (box :orientation "vertical"
         :space-evenly false
         :valign "center"
         :style "color: white;"
      (label :class "info-title"
             :text "RAM"
             :xalign 0)
      (label :text "Total: ${round(EWW_RAM.total_mem / (1024 * 1024 * 1024), 0)}GB"
             :xalign 0)
      (label :text "Used: ${round(EWW_RAM.used_mem / (1024 * 1024 * 1024), 0)}GB"
             :xalign 0)
      (label :text "Available: ${round(EWW_RAM.available_mem / (1024 * 1024 * 1024), 0)}GB  "
               :xalign 0))))

(defwidget rom_monitor []
    (left_widget :icon ""
                 :css_class "rom"
      (box :orientation "vertical"
           :space-evenly false
           :valign "center"
           :style "color: white;"
        (label :class "info-title"
               :text "ROM"
               :xalign 0)
        (label :text "Total: ${round(EWW_DISK["/"].total / (1024 * 1024 * 1024), 0)}GB"
               :xalign 0)
        (label :text "Used: ${round(EWW_DISK["/"].used / (1024 * 1024 * 1024), 0)}GB"
               :xalign 0)
        (label :text "Available: ${round(EWW_DISK["/"].free / (1024 * 1024 * 1024), 0)}GB  "
               :xalign 0))))
