;; Claude Agents from Berthier: one icon and count per status, zeros hidden except working.
;; The tooltip lists every count.
(defpoll claude_agents_data
  :interval "10s"
  :initial "{\"available\": false, \"working\": 0, \"blocked\": 0, \"done\": 0, \"idle\": 0, \"unknown\": 0, \"gone\": 0}"
  "claude-agents.sh")

(defwidget claude_agents []
  (eventbox :tooltip {claude_agents_data.available
                        ? "Claude agents
󰜎  ${claude_agents_data.working} working
󰀦  ${claude_agents_data.blocked} blocked, waiting on you
󰄬  ${claude_agents_data.done} done
󰒲  ${claude_agents_data.idle} idle
󰋗  ${claude_agents_data.unknown} unknown
󰚌  ${claude_agents_data.gone} gone"
                        : "Claude agents unavailable: Berthier's Main Loop is not updating"}
    (box :class "claude-agents"
         :space-evenly false
      (label :class "claude-agents-unavailable"
             :visible {!claude_agents_data.available}
             :text "󰚩 --")
      (box :space-evenly false
           :visible {claude_agents_data.available}
        (claude_agent_count :status "working" :icon "󰜎" :count {claude_agents_data.working})
        (claude_agent_count :status "blocked" :icon "󰀦" :count {claude_agents_data.blocked})
        (claude_agent_count :status "done" :icon "󰄬" :count {claude_agents_data.done})
        (claude_agent_count :status "idle" :icon "󰒲" :count {claude_agents_data.idle})
        (claude_agent_count :status "unknown" :icon "󰋗" :count {claude_agents_data.unknown})
        (claude_agent_count :status "gone" :icon "󰚌" :count {claude_agents_data.gone})))))

(defwidget claude_agent_count [status icon count]
  (box :class "claude-agent claude-agent-${status}"
       :space-evenly false
       :valign "center"
       :visible {count > 0 || status == "working"}
    (label :class "claude-agent-icon" :text icon)
    (label :class "claude-agent-count" :text "${count}")))
