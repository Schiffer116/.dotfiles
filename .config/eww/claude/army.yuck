;; The Army report on the laptop screen (bottom right): one block per Corps from
;; `berthier counts`, needs-you first. Plain text with a dark halo so it reads over the
;; wallpaper; each detail is cut to one line so seven Corps fit below the finance column.
(defwindow army
  :stacking "bg"
  :geometry (geometry
    :x 40
    :y 40
    :anchor "bottom right")
  (box :class "army"
       :orientation "vertical"
       :space-evenly false
       :visible {claude_agents_data.available && arraylength(claude_agents_data.corps) > 0}
    (label :class "info-title"
           :text "Army"
           :xalign 0)
    (for c in {claude_agents_data.corps}
      (box :orientation "vertical"
           :space-evenly false
           :class "army-corps"
        (box :space-evenly false
          (label :class "army-name" :text "${c.name}")
          (label :class "army-state ${c.state == 'needs you' ? 'army-needs-you' : ''}"
                 :text "${c.state}"))
        (label :xalign 0
               :text {strlength(c.detail) > 52 ? "${substring(c.detail, 0, 51)}…" : c.detail})))))
