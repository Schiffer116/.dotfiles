(defpoll claude_usage_data
  :interval "60s"
  :initial "{\"available\": false, \"session_percent\": 0, \"week_percent\": 0, \"session_used\": \"--\", \"session_reset\": \"--\", \"week_used\": \"--\", \"week_reset\": \"--\", \"next_reset_window\": \"--\", \"next_reset_at\": \"--\", \"next_reset_in\": \"--\"}"
  "claude-usage.sh")

;; Session and week rings for the bar, styled like the hardware monitors; details on hover.
(defwidget claude_usage []
  (eventbox :tooltip {claude_usage_data.available
                        ? "Claude session: ${claude_usage_data.session_used} used, resets ${claude_usage_data.session_reset}
Claude week: ${claude_usage_data.week_used} used, resets ${claude_usage_data.week_reset}
Next reset: ${claude_usage_data.next_reset_window} in ${claude_usage_data.next_reset_in} (${claude_usage_data.next_reset_at})"
                        : "Claude usage unavailable"}
    (box :space-evenly false
      (claude_ring :css_class "claude-session" :value {claude_usage_data.session_percent})
      (claude_ring :css_class "claude-week" :value {claude_usage_data.week_percent}))))

(defwidget claude_ring [value css_class]
  (circular-progress :class "circle ${css_class}"
                     :value value
                     :start-at 75
                     :thickness 4
    (label :class "circ-icon"
           :text "")))
