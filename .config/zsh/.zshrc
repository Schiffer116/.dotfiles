zmodload zsh/complist

###########
# options #
###########

HISTSIZE=10000
SAVEHIST=10000
HISTFILE=$XDG_CACHE_HOME/zsh/history

setopt HIST_IGNORE_ALL_DUPS
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY

##############
# completion #
##############

fpath=("$XDG_CONFIG_HOME/zsh" $fpath)

autoload -U compinit
zstyle ':completion:*' completer _extensions _complete _approximate
zstyle ':completion:*' menu select
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$XDG_CACHE_HOME/zsh/.zcompcache"
zstyle ':completion:*:*:*:*:descriptions' format '%F{green}-- %d --%f'
zstyle ':completion:*:warnings' format ' %F{red}-- no matches found --%f'

compinit
_comp_options+=(globdots)

autoload bashcompinit
bashcompinit
complete -C aws_completer aws


######
# vi #
######

bindkey -v
export KEYTIMEOUT=1

# cursor shape
cursor_mode() {
    cursor_block='\e[2 q'
    cursor_beam='\e[6 q'

    function zle-keymap-select {
        if [[ ${KEYMAP} == vicmd ]] ||
            [[ $1 = 'block' ]]; then
            echo -ne $cursor_block
        elif [[ ${KEYMAP} == main ]] ||
            [[ ${KEYMAP} == viins ]] ||
            [[ ${KEYMAP} = '' ]] ||
            [[ $1 = 'beam' ]]; then
            echo -ne $cursor_beam
        fi
    }

    zle-line-init() {
        echo -ne $cursor_beam
    }

    zle -N zle-keymap-select
    zle -N zle-line-init
}
cursor_mode

# menu selection
bindkey -M menuselect 'h' vi-backward-char
bindkey -M menuselect 'k' vi-up-line-or-history
bindkey -M menuselect 'l' vi-forward-char
bindkey -M menuselect 'j' vi-down-line-or-history

# text objects
autoload -Uz select-bracketed select-quoted
zle -N select-quoted
zle -N select-bracketed
for km in viopp visual; do
  bindkey -M $km -- '-' vi-up-line-or-history
  for c in {a,i}${(s..)^:-\'\"\`\|,./:;=+@}; do
    bindkey -M $km $c select-quoted
  done
  for c in {a,i}${(s..)^:-'()[]{}<>bB'}; do
    bindkey -M $km $c select-bracketed
  done
done


############
# keybinds #
############

bindkey -s '^f' 'tmux-session.sh^M'

###########
# aliases #
###########

alias dapterm='echo 0 | sudo tee /proc/sys/kernel/yama/ptrace_scope'

alias icat='kitty +kitten icat'

alias ls='eza --color=always --icons=always'
alias tree='eza --tree --color=always --icons=always'

alias grep='grep --color=auto'

alias du='du -h'
alias df='df -h'

# history-substring
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

alias microcode='grep . /sys/devices/system/cpu/vulnerabilities/*'

alias gs='git status'
alias gl='git log'

alias tf='terraform'
alias tfp='terraform plan'
alias tfa='terraform apply'
alias tfv='terraform validate'

##############
# shellhooks #
##############

eval "$(starship init zsh)"
eval "$(direnv hook $SHELL)"

# only from a local virtual console login, never over SSH
# exec: a Hyprland crash must not leave a logged-in shell behind the lock.
# Goes away once greetd is installed (system/greetd/config.toml).
if [[ -z $DISPLAY && -z $SSH_CONNECTION && $(tty) == /dev/tty[0-9]* ]]; then
    exec start-hyprland
fi

# generated by home-manager (nix/home/shell.nix)
source $ZDOTDIR/plugins.zsh

# Claude Code sessions are long-lived, not commands worth a notification when they exit
(( ${+AUTO_NOTIFY_IGNORE} )) && AUTO_NOTIFY_IGNORE+=("claude")

# Play a sound when a long-running command finishes (same trigger conditions as auto-notify above)
[[ -z "$AUTO_NOTIFY_SOUND_FILE" ]] &&
    export AUTO_NOTIFY_SOUND_FILE=/usr/share/sounds/freedesktop/stereo/complete.oga

function _auto_notify_sound_track() {
    AUTO_NOTIFY_SOUND_START="$(date +"%s")"
    AUTO_NOTIFY_SOUND_CMD="$3"
}

function _auto_notify_sound_play() {
    local exit_code="$?"
    [[ -z "$AUTO_NOTIFY_SOUND_START" ]] && return

    local current="$(date +"%s")"
    local elapsed=$((current - AUTO_NOTIFY_SOUND_START))
    if [[ $elapsed -gt $AUTO_NOTIFY_THRESHOLD ]] && [[ "$(_is_auto_notify_ignored "$AUTO_NOTIFY_SOUND_CMD")" == "no" ]]; then
        (paplay "$AUTO_NOTIFY_SOUND_FILE" &) 2>/dev/null
    fi
    unset AUTO_NOTIFY_SOUND_START AUTO_NOTIFY_SOUND_CMD
}

# auto-notify is only loaded in a graphical session
if (( $+functions[_is_auto_notify_ignored] )); then
    autoload -Uz add-zsh-hook
    add-zsh-hook preexec _auto_notify_sound_track
    add-zsh-hook precmd _auto_notify_sound_play
fi

